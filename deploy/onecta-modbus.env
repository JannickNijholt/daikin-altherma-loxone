# Onecta → Modbus bridge settings. Restart after changes: systemctl restart onecta-modbus
# Daikin app credentials and the login are set in the web UI, not here.

#ONECTA_MODBUS_PORT=502
#ONECTA_WEB_PORT=8080
# Protect the web UI with HTTP basic auth (any user name, this password):
#ONECTA_WEB_PASSWORD=

# Polling. Daikin allows about 200 API calls per day per account (reset 00:00 UTC);
# commands from Loxone count too.
#ONECTA_POLL_DAY_MINUTES=10
#ONECTA_POLL_NIGHT_MINUTES=30
#ONECTA_DAY_START=07:00
#ONECTA_NIGHT_START=22:00
# Poll at least this often, even when the budget is tight:
#ONECTA_MAX_POLL_MINUTES=60

# Budget guard
# Calls per day that polling leaves free for Loxone commands:
#ONECTA_COMMAND_RESERVE=50
# Stop commands above this many per hour (protects against runaway logic):
#ONECTA_MAX_COMMANDS_PER_HOUR=20
# Stop commands when this few calls are left today:
#ONECTA_MIN_CALLS_LEFT=5

# Seconds to wait for more Modbus writes before sending (slider moves):
#ONECTA_WRITE_DEBOUNCE=3
# Extra poll this many seconds after a command to confirm it (costs a call); 0 = off:
#ONECTA_REFRESH_AFTER_WRITE=0

#ONECTA_LOG_LEVEL=INFO
